{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile: papyrus",
            "type": "shell",
            "command": "c:/Skyrim/tools/papyrus-compiler/papyrus.exe",
            "args": [
                "compile",
                "-nocache",
                "-i", "${workspaceFolder}/Scripts/Source",
                "-o", "${workspaceFolder}/Scripts",
                "-h", "${workspaceFolder}/Headers",
                "-h",
                "${workspaceFolder}/Skyrim-Leash-Framework/papyrus/source",
                "-h",
                "C:/Skyrim/dev/mods/SKSE64/Scripts/Source"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "compile: pyro",
            "type": "shell",
            "command": "c:/Users/bhuff/.vscode/extensions/joelday.papyrus-lang-vscode-2024.578.1412/pyro/pyro.exe",
            "args": [
                "${workspaceFolder}/skyrimse.ppj",
                "--game-path",
                "C:\\Skyrim\\dev\\skyrim"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$PapyrusCompiler"
        },
        {
            "label": "compile: skyrim",
            "type": "shell",
            "command": "C:\\Skyrim\\dev\\skyrim\\Papyrus Compiler\\PapyrusCompiler.exe",
            "args": [
                "${workspaceFolder}/Scripts/Source",
                "-all",
                "-output=${workspaceFolder}/Scripts",
                "-import='${workspaceFolder}/Headers;${workspaceFolder}/Scripts/Source;${workspaceFolder}/Skyrim-Leash-Framework/papyrus/source'"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "git submodule update --init --recursive && cmake --preset debug",
            "options": {
                "cwd": "${workspaceFolder}/SKSE_Source"
            },
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            "label": "CMake: Build SKSE (Debug)",
            "type": "shell",
            "command": "cmake --build --preset build-debug && cmake -E make_directory \"${workspaceFolder}/SKSE/Plugins\" && cmake -E copy_if_different \"${workspaceFolder}/SKSE_Source/build/debug/Debug/SkyrimNet_Leashed.dll\" \"${workspaceFolder}/SKSE/Plugins/SkyrimNet_Leashed.dll\"",
            "options": {
                "cwd": "${workspaceFolder}/SKSE_Source"
            },
            "dependsOn": "CMake: Configure (Debug)",
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "git submodule update --init --recursive && cmake --preset release",
            "options": {
                "cwd": "${workspaceFolder}/SKSE_Source"
            },
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            "label": "CMake: Build SKSE (Release)",
            "type": "shell",
            "command": "cmake --build --preset build-release && cmake -E make_directory \"${workspaceFolder}/SKSE/Plugins\" && cmake -E copy \"${workspaceFolder}/SKSE_Source/build/release/Release/SkyrimNet_Leashed.dll\" \"${workspaceFolder}/SKSE/Plugins/SkyrimNet_Leashed.dll\"",
            "options": {
                "cwd": "${workspaceFolder}/SKSE_Source"
            },
            "dependsOn": "CMake: Configure (Release)",
            "problemMatcher": ["$msCompile"],
            "group": "build"
        },
        {
            "label": "Copy DLL to SKSE/Plugins (Debug)",
            "type": "shell",
            "command": "cmake -E make_directory \"${workspaceFolder}/SKSE/Plugins\" && cmake -E copy_if_different \"${workspaceFolder}/SKSE_Source/build/debug/Debug/SkyrimNet_Leashed.dll\" \"${workspaceFolder}/SKSE/Plugins/SkyrimNet_Leashed.dll\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build SKSE (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Copy DLL to SKSE/Plugins (Release)",
            "type": "shell",
            "command": "cmake -E make_directory \"${workspaceFolder}/SKSE/Plugins\" && cmake -E copy \"${workspaceFolder}/SKSE_Source/build/release/Release/SkyrimNet_Leashed.dll\" \"${workspaceFolder}/SKSE/Plugins/SkyrimNet_Leashed.dll\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake: Build SKSE (Release)",
            "problemMatcher": []
        }
    ]
}
