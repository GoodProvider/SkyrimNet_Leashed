<?xml version='1.0'?>
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="Scripts"
    Optimize="false"
    Release="false"
    Zip="false"
    Final="false">
    <Variables>
        <Variable Name="ModName" Value="SkyrimNet Leashed" />
        <Variable Name="ModsFolder" Value="C:\Skyrim\dev\mods" />
    </Variables>
    <Imports>
        <Import>Scripts\Source</Import>
        <Import>Headers</Import>
        <Import>SkyrimNet-GamePlugin\Source\Scripts</Import>
        <Import>@ModsFolder\SKSE64\Scripts\Source</Import>
        <Import>C:\Skyrim\dev\skyrim\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>Scripts\Source</Folder>
    </Folders>
</PapyrusProject>
